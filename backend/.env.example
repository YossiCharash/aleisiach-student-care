APP_NAME=Aleisiach Student Care
APP_ENVIRONMENT=local
APP_CORS_ORIGINS=http://localhost:5173
# HSTS max-age (seconds); the header is sent only when APP_ENVIRONMENT=production
APP_HSTS_MAX_AGE_SECONDS=31536000
# Number of trusted reverse proxies in front of the app. 0 = read the peer address
# directly; set to the hop count (e.g. 1 behind a single load balancer) to take the
# client IP from X-Forwarded-For for rate limiting.
APP_TRUSTED_PROXY_COUNT=0

DATABASE_URL=postgresql+psycopg://aleisiach:aleisiach@localhost:5432/aleisiach

AUTH_SESSION_TTL_MINUTES=480
AUTH_INVITE_TOKEN_TTL_HOURS=72
AUTH_RESET_TOKEN_TTL_HOURS=2
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
# Per-IP rate limit applied to each sensitive auth endpoint (login, reset, invite-accept)
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Where the rate-limit counters live. `memory` keeps them in the process, so every extra
# worker or instance multiplies the quota above — fine for a single local process, never
# for production. `database` shares one counter across every instance via PostgreSQL.
RATELIMIT_PROVIDER=memory
# Minutes to keep rate-limit rows before `python -m backend.app.cleanup` prunes them.
RATELIMIT_RETENTION_MINUTES=60

# Email delivery. `console` logs the link (dev default); `smtp` sends over SMTP with the
# settings below. Invitations and password resets are sent through this sender.
# Brand palette used by the server-rendered PDFs (CLAUDE.md §1).
BRAND_PRIMARY_COLOR=#3F8420
BRAND_ACCENT_COLOR=#85C441

EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@aleisiach.local
# Base URLs the invite/reset links are built from. Must point at the DEPLOYED FRONTEND
# origin in production (e.g. https://your-app.onrender.com/accept-invitation) — the backend
# cannot infer it. The paths must match the frontend routes (/accept-invitation, /reset-password).
EMAIL_INVITE_BASE_URL=http://localhost:5173/accept-invitation
EMAIL_RESET_BASE_URL=http://localhost:5173/reset-password
# SMTP settings (used only when EMAIL_PROVIDER=smtp). Defaults target Gmail SMTP; the
# username/password are a Gmail address + app password. Never commit real credentials —
# set these in the deployment environment.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=true
EMAIL_SMTP_TIMEOUT_SECONDS=10.0

WHATSAPP_PROVIDER=console
WHATSAPP_ENABLED=true
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TIMEOUT_SECONDS=5.0
WHATSAPP_RECIPIENT=

# Days to keep expired sessions/auth tokens before `python -m backend.app.cleanup` prunes them.
RETENTION_EXPIRED_CREDENTIALS_DAYS=90

# Platform super admin — the account that manages the list of institutions and has no access to
# any institution's data. On startup, if all four values are set and no super admin exists yet,
# an ACTIVE super_admin is created with these credentials. This is the very first login: it
# creates the first institution and invites that institution's manager. Leave any value empty to
# disable. The password must satisfy the password policy (min length + at least one letter and
# one digit). Never commit a real password here: set these in the deployment environment, and
# clear them once the first login has happened.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
